# Backend Environment Variables
# Copy this file to .env.local and fill in your values

# App Config
DEBUG=false
APP_NAME=DealMind
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dealmind
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_BUCKET=deals

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_key_here

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# External APIs
GOOGLE_MAPS_API_KEY=your-key-here
GOOGLE_GEOCODING_API_KEY=your-key-here
RENTCAST_API_KEY=your-key-here

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@dealmind.io

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:19000,http://localhost:8081
